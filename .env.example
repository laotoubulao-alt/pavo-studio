# Agnes: text, image, and image-to-video
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_TEXT_MODEL=agnes-2.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# OpenAI-compatible providers. Fill only the services you use.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEXT_MODEL=deepseek-chat

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_TEXT_MODEL=moonshot-v1-32k

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=qwen-plus

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_TEXT_MODEL=glm-4-flash

CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_TEXT_MODEL=

PORT=8787

# Optional system proxy, for example http://127.0.0.1:7892
HTTPS_PROXY=
